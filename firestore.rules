rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // User & Username Registry (Allow unauthenticated read for username login lookup)
    match /usernames/{document=**} {
      allow read, write: if true;
    }

    match /users/{document=**} {
      allow read, write: if true;
    }

    // Master Data Collections
    match /rawMaterials/{document=**} {
      allow read, write: if true;
    }

    match /finishedGoods/{document=**} {
      allow read, write: if true;
    }

    match /vendors/{document=**} {
      allow read, write: if true;
    }

    match /buyers/{document=**} {
      allow read, write: if true;
    }

    // Operational Collections
    match /jobWorks/{document=**} {
      allow read, write: if true;
    }

    match /salesOrders/{document=**} {
      allow read, write: if true;
    }

    match /dispatches/{document=**} {
      allow read, write: if true;
    }

    // Append-only Inventory Ledger
    match /stockMovements/{document=**} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
